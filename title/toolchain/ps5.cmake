# CMake toolchain for static libraries linked into our PS5 title.
set(CMAKE_SYSTEM_NAME FreeBSD)
set(CMAKE_SYSTEM_VERSION 9)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_CROSSCOMPILING ON)
set(_vk "$ENV{HOME}/ps5/PS5_Vulkan")
set(_sdk "${_vk}/.deps/native/ps5-payload-sdk")
set(CMAKE_C_COMPILER "${CMAKE_CURRENT_LIST_DIR}/ps5-cc")
set(CMAKE_CXX_COMPILER "${CMAKE_CURRENT_LIST_DIR}/ps5-c++")
set(CMAKE_AR "${_sdk}/bin/prospero-ar" CACHE FILEPATH "")
set(CMAKE_RANLIB "${_sdk}/bin/prospero-ranlib" CACHE FILEPATH "")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
set(BUILD_SHARED_LIBS OFF)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE BOTH)
